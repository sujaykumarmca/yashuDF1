{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "BSKGitDataFactory"
		},
		"AZ_STRG_Gen2_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AZ_STRG_Gen2_LS'"
		},
		"Azure_SQL_Third_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Azure_SQL_Third_DB'"
		},
		"AZ_STRG_Gen2_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://yashustrgact1.dfs.core.windows.net/"
		},
		"Azure_SQL_Third_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "yashhita.database.windows.net"
		},
		"Azure_SQL_Third_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "third"
		},
		"Azure_SQL_Third_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "yashita"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pipeline1')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data1",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "Azure_SQL_Third_DB",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_STRG_CSV_1",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/Azure_SQL_Third_DB')]",
				"[concat(variables('factoryId'), '/datasets/DS_STRG_CSV_1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Azure_SQL_Third_DB')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "Azure_SQL_Third_DB",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "cost",
						"type": "int",
						"precision": 10
					},
					{
						"name": "monthOfYear",
						"type": "varchar"
					},
					{
						"name": "RevenueTillDate",
						"type": "decimal",
						"precision": 18,
						"scale": 2
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "MonthRevenueTillDate"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/Azure_SQL_Third_DB')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_STRG_CSV_1')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AZ_STRG_Gen2_LS",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat('MonthRevenueTillDate_Starting',adddays(startOfMonth(utcNow()),-1,'ddMMYYYY'),'_Ending',formatDateTime(utcNow(),'ddMMYYYY'),'.csv')",
							"type": "Expression"
						},
						"folderPath": "ANNU",
						"fileSystem": "input-data"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AZ_STRG_Gen2_LS')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/AZ_STRG_Gen2_LS')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('AZ_STRG_Gen2_LS_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('AZ_STRG_Gen2_LS_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Azure_SQL_Third_DB')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('Azure_SQL_Third_DB_properties_typeProperties_server')]",
					"database": "[parameters('Azure_SQL_Third_DB_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('Azure_SQL_Third_DB_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('Azure_SQL_Third_DB_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}